# --- Database (Turso) ---
TURSO_DATABASE_URL="libsql://music-app-xxx.turso.io"
TURSO_AUTH_TOKEN="eyJ..."

# --- Object Storage (Cloudflare R2 - เก็บไฟล์ mp3/jpg) ---
R2_ACCOUNT_ID="xxxx"
R2_ACCESS_KEY_ID="xxxx"
R2_SECRET_ACCESS_KEY="xxxx"
R2_BUCKET_NAME="music-app"
R2_PUBLIC_URL="https://pub-xxx.r2.dev"

# --- Auth (Auth.js v5) ---
# สุ่มด้วย: openssl rand -base64 32  หรือ  npx auth secret
AUTH_SECRET="เปลี่ยนเป็นค่าที่สุ่มเอง"
# Google login: https://console.cloud.google.com/apis/credentials -> Create OAuth client (Web)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# (ตอน deploy เพิ่ม https://โดเมนของคุณ/api/auth/callback/google ด้วย)
AUTH_GOOGLE_ID="xxxx.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="xxxx"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# เปิดปุ่ม Google เมื่อใส่ AUTH_GOOGLE_* ครบแล้ว (0 = ซ่อน)
NEXT_PUBLIC_GOOGLE_ENABLED="0"
# fallback ตอน dev ที่ยังไม่ล็อกอิน (production ควรล็อกอินก่อนโพสต์)
DEMO_USER_ID="demo-user-1"
